OMEGA_BIND_HOST=127.0.0.1
OMEGA_BACKEND_PORT=8001
# Optional: relocate mutable tool runtime state outside the checkout.
# OMEGA_TOOL_DATA_DIR=C:/path/to/omega-runtime/tool-data
TURNING_DB_PATH=omega_arc.db
# Required before Bridge Zero Mobile endpoints will accept requests.
# Generate a long random value; never commit the real token.
MOBILE_AUTH_TOKEN=
RUNTIME_VERSION=0.2.0
REQUIRED_MOBILE_VERSION=0.2.0
MOBILE_API_VERSION=1
CHRONICLE_PATH=bridge/shared/mobile/chronicle.json
MAX_HISTORY_MESSAGES=12
MAX_MEMORY_RESULTS=6

OLLAMA_BASE_URL=http://localhost:11434/api
ACTIVE_CHAT_MODEL=dolphin-mixtral:8x7b
DIRECT_CHAT_MODEL=dolphin-mixtral:8x7b
# OLLAMA_CHAT_MODEL remains a backwards-compatible alias when ACTIVE_CHAT_MODEL is unset.
OLLAMA_CHAT_MODEL=dolphin-mixtral:8x7b
MODEL_LOCK=true
ALLOW_TOPIC_ROUTING=false
ALLOW_SECONDARY_REWRITE=false
ALLOW_AUTOMATIC_MODEL_FALLBACK=false
AUTOMATIC_MODEL_FALLBACK_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=embeddinggemma

ENABLE_WEB_SEARCH=false
WEB_SEARCH_MAX_RESULTS=5
ENABLE_COGNITION_PIPELINE=true
ENABLE_COGNITION_CONTEXT=false
ENABLE_CURIOSITY_SUGGESTIONS=false
ENABLE_REASONING_PIPELINE=true
ENABLE_REASONING_CONTEXT=false
ENABLE_ACTION_RECOMMENDATIONS=true
ENABLE_PLANNING_PIPELINE=true
ENABLE_PLANNING_CONTEXT=false
ENABLE_DECISION_RECORDS=true
ENABLE_AUTOMATIC_PLAN_REVISION=true
ENABLE_DELIBERATION_PIPELINE=true
ENABLE_DELIBERATION_CONTEXT=false
ENABLE_PLAN_EXECUTION=false
ENABLE_TOOL_FRAMEWORK=true
ENABLE_TOOL_EXECUTION=true
ENABLE_TOOL_DRY_RUN=true
ENABLE_CRITICAL_TOOLS=false
ENABLE_BACKEND_HEALTH_CHECK=true
BACKEND_HEALTH_CHECK_TIMEOUT_SECONDS=3
BACKEND_HEALTH_CHECK_PATHS=/health,/system/status,/
TOOL_APPROVAL_TTL_SECONDS=300
# IX-D command console (ADR 0015): operator-initiated commands. Approval-gated commands execute
# only after a biometric-confirmed operator approval, so this is ON by default — separate from
# ENABLE_TOOL_EXECUTION, which governs the model-initiated chat tool path.
COMMAND_EXECUTION=true
# XIII-A agent loop (ADR 0026): the chat seat may call registered commands as tools; the runtime
# executes them under the consoles' gates (direct reads run, side effects wait for a biometric
# approval, anything else is refused and recorded). OFF by default — turning it on is the recorded
# operator action that supersedes the ADR 0015 chat-path freeze, and only through the loop.
ENABLE_AGENT_LOOP=false
# Bounded loop budget: tool rounds per turn, and tool-result characters fed back into context.
AGENT_LOOP_MAX_HOPS=4
AGENT_LOOP_RESULT_MAX_CHARS=4000
# XIII-C Mind Ladder (ADR 0026): rung 2 = the deep local gear (thinks in system RAM, slow by
# design); rung 3 = the frontier planner via the operator's Groq key — a network call, so it
# executes only while the network breaker is ON and lands in the fetch log. Only the composed
# task text ever travels; private rooms never ride along (structural: no other input exists).
DEEP_LOCAL_MODEL=huihui_ai/qwen3-abliterated:30b-a3b
GROQ_PLANNER_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=   (operator-provided; never commit the real key)
# XIII-E Workbench (ADR 0027): who drafts code proposals. "groq" = the frontier planner above
# (free tier: 8k tokens per request, drafts are paced one file per reply). "claude-code" = the
# operator's Claude Code CLI on his subscription (`claude -p`, tools off; sign in once with
# `claude`). Falls back down the ladder when the chosen drafter fails.
WORKBENCH_DRAFTER=groq
WORKBENCH_CLAUDE_MODEL=sonnet
