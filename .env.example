OLLAMA_BASE_URL=http://127.0.0.1:11434
ACTIVE_CHAT_MODEL=huihui_ai/gemma-4-abliterated:12b
# OLLAMA_CHAT_MODEL remains a backwards-compatible alias when ACTIVE_CHAT_MODEL is unset.
OLLAMA_CHAT_MODEL=huihui_ai/gemma-4-abliterated:12b
MODEL_LOCK=true
ALLOW_TOPIC_ROUTING=false
ALLOW_SECONDARY_REWRITE=false
ALLOW_AUTOMATIC_MODEL_FALLBACK=false
AUTOMATIC_MODEL_FALLBACK_MODEL=llama3.1:8b
OLLAMA_REASONING_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_ROUTER_MODEL=gemma3:1b
OLLAMA_EMBED_MODEL=embeddinggemma:latest
NETWORK_MODE=offline
ACTIVE_PERSONALITY_MODE=default
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Epoch X memory knobs (see ADRs 0016-0023; defaults shown)
# MEMORY_RECENCY_WEIGHT=0.05
# MEMORY_LEXICAL_WEIGHT=0
# MEMORY_FUZZY_WEIGHT=0
# MEMORY_SUPERSEDE_THRESHOLD=0          # calibrated recommendation when enabling: 0.80
# MEMORY_SUPERSEDE_DECLARED_THRESHOLD=0 # calibrated recommendation when enabling: 0.45
# MEMORY_CONSOLIDATION_THRESHOLD=0.95

# Thinking models: keep the hidden reasoning phase off in-app (see OLLAMA_THINK in app.py)
OLLAMA_THINK=false
